# Artefactos de pruebas E2E Playwright
/test-results
/tests/playwright-report
/tests/playwright_gestion_usuarios/evidencia
/playwright/.cache

# Documentacion entregable de la unidad 2. La regla /docs/* de arriba ignora las
# subcarpetas de docs/, asi que hay que reincluirla de forma explicita.
!/docs/entrega-u2/

# Artefacto generado con pandoc a partir de los .md de docs/entrega-u2.
# No se versiona: se regenera localmente cuando haga falta.
/docs/entrega-u2/*.docx

# Resultados crudos de las pruebas de carga. El resumen se versiona en markdown
# y en docs/entrega-u2/evidencia; el JSON completo de k6 pesa decenas de MB.
/tests/carga/resultados/*.json

# Checklists historicos de la infraestructura IONOS ya desaparecida. Contienen
# host, usuario y password en claro; el repositorio es publico y no deben
# versionarse nunca. Se conservan solo en local como registro del equipo.
/docs/IONOS_Deploy_Checklist.md
/docs/MedSchedule_Estructura_DB_IONOS.md

# Documentacion entregable de la unidad 3. Igual que en la unidad 2, la regla
# /docs/* ignora las subcarpetas de docs/ y hay que reincluirla.
!/docs/entrega-u3/

# DOCX generado con pandoc a partir de los .md de docs/entrega-u3.
/docs/entrega-u3/*.docx

# Configuracion local del stack de monitoreo: credenciales de Grafana, del
# exporter de MySQL y el token de metricas que lee Prometheus.
/infra/monitoreo/.env
/infra/monitoreo/prometheus/secretos/

# Regla global de seguridad del autor: variantes de .env (salvo las plantillas
# .env.example), llaves y certificados, carpetas de secretos y respaldos SQL.
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/
*.sql.gz
